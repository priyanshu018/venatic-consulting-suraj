# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="not currently used by the app, but fine to keep set"
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used once by `pnpm seed:admin` to create the first admin login.
# Not read by the app at runtime — safe to remove after seeding.
ADMIN_EMAIL="you@venaticconsulting.com"
ADMIN_PASSWORD="choose-a-strong-password"
