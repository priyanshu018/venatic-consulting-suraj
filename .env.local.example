# Postgres connection string. Works with Neon, Supabase, Vercel Postgres, or any
# standard Postgres provider. For Vercel deployments, use your provider's pooled
# connection string (e.g. Neon's "-pooler" host, or Supabase port 6543).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used once by `pnpm seed:admin` to create the first admin login.
# Not read by the app at runtime — safe to remove after seeding.
ADMIN_EMAIL="you@venaticconsulting.com"
ADMIN_PASSWORD="choose-a-strong-password"
